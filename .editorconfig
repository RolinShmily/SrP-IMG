# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces mean a hard line break in Markdown.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# index.js and functions/pic.js are regenerated by gen_img.py — keep the
# generator's own 4-space indentation instead of reformatting by hand.
[index.js]
indent_size = 4

[functions/pic.js]
indent_size = 4
