# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces mean a hard line break in Markdown.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Worker runtime source uses 4-space indentation; keep it stable instead of
# reformatting by hand.
[worker/*.js]
indent_size = 4

[functions/*.js]
indent_size = 4
