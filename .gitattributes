# Normalize text files to LF in the repository and in the working tree, so a
# Windows checkout and a Linux CI build produce byte-identical files.
* text=auto eol=lf

# Binary assets — never rewrite their line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary

# Produced by `python -m pipeline` at build time; collapse it in diffs.
worker/targets.js                 linguist-generated=true
worker/slot_formats.js            linguist-generated=true
assets/generated/counts.json      linguist-generated=true

# Image sets are assets, not source — keep them out of the language stats.
assets/original/**  linguist-vendored=true
assets/generated/** linguist-vendored=true
