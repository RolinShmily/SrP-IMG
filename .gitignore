# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# production build output (Vite multi-page build: dist/ = wrangler asset dir)
/dist/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# lockfiles
# package-lock.json is committed on purpose: CI runs `npm ci` so every deploy
# installs the exact locked versions instead of re-resolving version ranges.
# Lockfiles for other package managers stay ignored.
pnpm-lock.yaml
yarn.lock
bun.lockb
bun.lock

# env files
.env*

# vercel
.vercel

# Local agent / tooling artifacts — never part of the shipped project
.claude
.memory
.archify/
dev.log

# typescript
*.tsbuildinfo

# Generated image pool — produced by `python -m pipeline`, copied into dist/ by
# vite.config.ts. Only the manifest is tracked: it is the build's data contract.
# The hand-written static files live in assets/static/ and are committed.
/assets/generated/*
!/assets/generated/counts.json

# Python
__pycache__/

# Cloudflare
/.wrangler/
.playwright-mcp/

# Local Worker bindings for `wrangler dev`. Real allowlists live in Cloudflare
# (secret put / dashboard), never in the repo; .dev.vars.example is the template.
.dev.vars
.dev.vars.*
!.dev.vars.example

# OS / editor junk
.DS_Store
Thumbs.db
