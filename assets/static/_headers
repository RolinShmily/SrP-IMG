# Cloudflare Workers / Pages Static Assets headers

# Immutable cache for generated static images (1 year)
/h/*
  Cache-Control: public, max-age=31536000, immutable
/v/*
  Cache-Control: public, max-age=31536000, immutable
/a/*
  Cache-Control: public, max-age=31536000, immutable
/gif/*
  Cache-Control: public, max-age=31536000, immutable

# NOTE: the hashed bundle under /assets/* is deliberately not given a long
# max-age. _headers matches by path only, so an `immutable` rule would also pin
# a transient 404 (e.g. while a bad edge rule rewrites /assets/*) for a year.
# Self-hosted fonts: stable names, so rename them when the file changes
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Metadata index should revalidate
/counts.json
  Cache-Control: public, max-age=0, must-revalidate

# General security header
/*
  X-Content-Type-Options: nosniff
